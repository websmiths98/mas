"use client";

import React, { useState, useRef } from "react";
import { motion, useInView, AnimatePresence } from "framer-motion";
import Link from "next/link";
import { cn } from "@/lib/utils";

/* ---------------- Icons ---------------- */
const IconWrap = ({ children, className }: { children: React.ReactNode; className?: string }) => (
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth={1.5} className={className}>{children}</svg>
);
const IconPlane = ({ className }: { className?: string }) => <IconWrap className={className}><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/></IconWrap>;
const IconShip = ({ className }: { className?: string }) => <IconWrap className={className}><path d="M2 21c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1 .6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/><path d="M19.38 20A11.6 11.6 0 0 0 21 14l-9-4-9 4c0 2.9.94 5.34 2.81 7.76"/><path d="M19 13V7a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v6"/><path d="M12 10v4"/><path d="M12 2v3"/></IconWrap>;
const IconWarehouse = ({ className }: { className?: string }) => <IconWrap className={className}><path d="M22 8.35V20a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8.35A2 2 0 0 1 3.26 6.5l8-3.2a2 2 0 0 1 1.48 0l8 3.2A2 2 0 0 1 22 8.35Z"/><path d="M6 18h12"/><path d="M6 14h12"/><rect width="12" height="12" x="6" y="10"/></IconWrap>;
const IconFile = ({ className }: { className?: string }) => <IconWrap className={className}><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><path d="m9 15 2 2 4-4"/></IconWrap>;
const IconBoxes = ({ className }: { className?: string }) => <IconWrap className={className}><path d="M2.97 12.92A2 2 0 0 0 2 14.63v3.24a2 2 0 0 0 .97 1.71l3 1.8a2 2 0 0 0 2.06 0L12 19v-5.5l-5-3-4.03 2.42Z"/><path d="m7 16.5-4.74-2.85"/><path d="m7 16.5 5-3"/><path d="M7 16.5v5.17"/><path d="M12 13.5V19l3.97 2.38a2 2 0 0 0 2.06 0l3-1.8a2 2 0 0 0 .97-1.71v-3.24a2 2 0 0 0-.97-1.71L17 10.5l-5 3Z"/><path d="m17 16.5-5-3"/><path d="m17 16.5 4.74-2.85"/><path d="M17 16.5v5.17"/><path d="M7.97 4.42A2 2 0 0 0 7 6.13v4.37l5 3 5-3V6.13a2 2 0 0 0-.97-1.71l-3-1.8a2 2 0 0 0-2.06 0l-3 1.8Z"/><path d="M12 8 7.26 5.15"/><path d="m12 8 4.74-2.85"/><path d="M12 13.5V8"/></IconWrap>;
const IconContainer = ({ className }: { className?: string }) => <IconWrap className={className}><path d="M22 7.7c0-.6-.4-1.2-.8-1.5l-6.3-3.9a1.72 1.72 0 0 0-1.7 0l-10.3 6c-.5.2-.9.8-.9 1.4v6.6c0 .5.4 1.2.8 1.5l6.3 3.9a1.72 1.72 0 0 0 1.7 0l10.3-6c.5-.3.9-1 .9-1.5Z"/><path d="M10 21.9V14L2.1 9.1"/><path d="m10 14 11.9-6.9"/><path d="M14 19.5V8.5"/><path d="M18 17V7"/></IconWrap>;

/* ---------------- Animated Text ---------------- */
const AnimatedText = ({ text, className }: { text: string; className?: string }) => {
  const ref = useRef(null);
  const isInView = useInView(ref, { once: false, amount: 0.1 });
  return (
    <motion.span ref={ref} className={cn("flex flex-col", className)} initial="hidden" animate={isInView ? "visible" : "hidden"}>
      {text.split("\n").map((line, i) => (
        <span key={i} className="flex flex-wrap min-h-[1.2em]">
          {line.split(" ").map((word, j) => (
            <span key={j} className="mr-[0.3em] inline-block whitespace-nowrap overflow-hidden">
              {word.split("").map((char, k) => (
                <motion.span key={k} variants={{ hidden: { y: "100%" }, visible: { y: 0, transition: { duration: 0.4, ease: [0.33, 1, 0.68, 1] } } }} className="inline-block">{char}</motion.span>
              ))}
            </span>
          ))}
        </span>
      ))}
    </motion.span>
  );
};

/* ---------------- Data ---------------- */
const SERVICES = [
  { id: "1", title: "Air Freight", image: "/air_freight_service.png", icon: IconPlane, highlights: ["Express & Charter", "200+ Destinations"], description: `We provide fast and reliable air freight services through strong partnerships with leading global carriers. Our network enables smooth handling of time-sensitive shipments across international destinations.\n\n➤ Priority and express shipments\n➤ Global carrier network\n➤ Secure cargo handling\n➤ Time-critical delivery support` },
  { id: "2", title: "Sea Freight", image: "/sea_freight_services.jpeg", icon: IconShip, highlights: ["FCL & LCL", "Global Carriers"], description: `Our sea freight solutions are designed for flexibility and cost efficiency. Whether it is full container loads or smaller shipments, we ensure reliable movement through our global partner network.\n\n➤ FCL and LCL shipments\n➤ Competitive global routing\n➤ Strong port connectivity\n➤ End-to-end shipment visibility` },
  { id: "3", title: "Warehousing & Distribution", image: "/warehousing__Distribution_logistics_service.jpeg", icon: IconWarehouse, highlights: ["Bonded Storage", "Last-Mile"], description: `MAS warehousing services are specifically designed for your requirement; gives flexibility and scalability to cater to your business growth and overall needs. Enhanced customer experience, reduced cost of operation, efficient processes and Short lead time are some of the benefits of opting for dedicated warehouse.\n\nMAS offer shared warehouse, if you have low volumes, uncertain demand or seasonal operational fluctuations, operating in a shared warehousing allows you to enjoy the benefits of all inputs at significantly low cost.` },
  { id: "4", title: "Project & ODC Cargo", image: "/project___ODC_Cargo_services.jpeg", icon: IconBoxes, highlights: ["Heavy Lift", "Route Surveys"], description: `We specialize in handling oversized, heavy-lift, and complex cargo that requires careful planning and execution. Our team ensures safe handling and timely delivery of critical shipments.\n\n➤ Heavy and oversized cargo handling\n➤ Route planning and coordination\n➤ Specialized equipment support\n➤ End-to-end project execution` },
  { id: "5", title: "Break-Bulk Shipping", image: "/Break-Bulk_Cargo_services.jpeg", icon: IconContainer, highlights: ["Charter Vessels", "Port Ops"], description: `MAS Logistics break-bulk services are designed to meet your shipping needs of over-sized, odd-sized or over-weight cargoes.\n\nApart from regular sailings, We also provide entire transportation solutions including pre-carriages and on carriages for general cargo, project cargo including over-sized units or heavy lifts, steel products, etc. Our add-on options include packing, crating and rigging to ensure maximum protection of your cargoes.\n\nPartnering with leading carriers around the world, we provide a wide selection of ocean vessels, containers and trailers to suit your special shipment needs.` },
  { id: "6", title: "Customs Brokerage", image: "/customs_brokerage_specialized_services.jpeg", icon: IconFile, highlights: ["HS Classification", "Compliance"], description: `Our highly efficient customs brokerage, clearance and compliance service is designed to take the complexity out of the customs process.\n\nTo ensure the complete security of your goods, even in challenging environments, our personnel serve as the first point of contact with both customs authorities and receiving customers. This allows us to provide reassuring guidance and expert advice on matters relating to customs.\n\nWhen it comes to moving your products across international borders, MAS Logistics provides you with a smooth and hassle-free experience.` },
];

/* ---------------- Main Components ---------------- */
export default function Services() {
  const [active, setActive] = useState(0);

  return (
    <main className="relative flex h-screen max-h-screen flex-col overflow-hidden bg-[#0a0f14] text-white">
      {/* Dynamic Background Glow */}
      <div className="absolute inset-0 z-0 overflow-hidden pointer-events-none">
        <div className="absolute -top-[10%] -left-[10%] h-[40%] w-[40%] rounded-full bg-cyan-500/10 blur-[120px]" />
        <div className="absolute top-[20%] -right-[5%] h-[30%] w-[30%] rounded-full bg-blue-600/5 blur-[100px]" />
      </div>

      <header className="relative z-50 pt-6 px-10 flex justify-center shrink-0">
        <nav className="inline-flex gap-8 px-8 py-3 rounded-full border border-white/5 bg-white/5 backdrop-blur-2xl shadow-2xl">
          {["Home", "Services", "Solutions", "Industries", "About us"].map((name) => (
            <Link key={name} href={name === "Home" ? "/" : `/${name.toLowerCase().replace(" ", "")}`}
                  className={cn("text-[13px] font-bold tracking-widest uppercase transition-all hover:text-cyan-400", name === "Services" ? "text-cyan-400" : "text-gray-400")}>
              {name}
            </Link>
          ))}
        </nav>
      </header>

      <section className="relative z-40 px-12 mt-8 mb-4 shrink-0">
        <div className="flex flex-col gap-2">
          <div className="flex items-center gap-3">
            <span className="h-px w-8 bg-cyan-500" />
            <span className="text-[10px] font-black tracking-[0.5em] uppercase text-cyan-500">Logistics Excellence</span>
          </div>
          <h1 className="text-4xl lg:text-5xl font-black tracking-tighter uppercase">Our Services</h1>
          <p className="max-w-3xl text-gray-400 text-sm lg:text-base font-medium">
            Reliable and efficient solutions across global markets, designed to support your supply chain with clarity and control.
          </p>
        </div>
      </section>

      <section className="relative z-40 flex-1 px-8 pb-8 min-h-0">
        <div className="flex h-full w-full gap-4 lg:flex-row flex-col">
          {SERVICES.map((item, i) => {
            const isActive = active === i;
            const Icon = item.icon;
            return (
              <motion.div
                key={item.id}
                onMouseEnter={() => setActive(i)}
                className={cn(
                  "relative flex flex-col overflow-hidden rounded-[2rem] border transition-all duration-700 cursor-pointer",
                  isActive ? "lg:flex-[6] flex-[4] border-white/20 shadow-2xl" : "lg:flex-[1] flex-[1] border-white/5 bg-white/[0.02] grayscale hover:grayscale-0"
                )}
              >
                {/* Background Image Layer */}
                <motion.div
                  initial={false}
                  animate={{ scale: isActive ? 1.05 : 1.2, opacity: isActive ? 0.6 : 0.3 }}
                  transition={{ duration: 1.5, ease: [0.33, 1, 0.68, 1] }}
                  className="absolute inset-0 bg-cover bg-center"
                  style={{ backgroundImage: `url(${item.image})` }}
                />

                {/* Gradient Wash */}
                <div className={cn("absolute inset-0 transition-colors duration-700", isActive ? "bg-gradient-to-t from-[#0a0f14] via-transparent to-transparent" : "bg-[#0a0f14]/80")} />

                <div className="relative z-20 flex h-full w-full flex-col p-8 justify-between">
                  {/* Top: Icon & Index */}
                  <div className="flex justify-between items-start">
                    <div className={cn("p-4 rounded-2xl border transition-all duration-500", isActive ? "bg-cyan-400/20 border-cyan-400/50 shadow-[0_0_20px_rgba(34,211,238,0.3)]" : "bg-black/40 border-white/10")}>
                      <Icon className={cn("h-6 w-6 transition-colors", isActive ? "text-cyan-400" : "text-white/20")} />
                    </div>
                    <span className={cn("font-mono text-xs font-bold tracking-tighter", isActive ? "text-cyan-400" : "text-white/10")}>
0{i+1}</span>
                  </div>

                  {/* Bottom: Content Container */}
                  <div className="flex flex-col gap-4">
                    <AnimatePresence mode="wait">
                      {isActive ? (
                        <motion.div
                          key="active"
                          initial={{ opacity: 0, x: -20 }}
                          animate={{ opacity: 1, x: 0 }}
                          exit={{ opacity: 0, x: 10 }}
                          transition={{ duration: 0.5, ease: "easeOut" }}
                          className="max-w-2xl"
                        >
                          <h3 className="text-4xl lg:text-5xl font-black uppercase tracking-tighter leading-none mb-4 whitespace-normal">{item.title}</h3>
                          <div className="text-sm lg:text-base text-gray-300 font-medium leading-relaxed mb-6">
                            <AnimatedText text={item.description} />
                          </div>
                          <div className="flex flex-wrap gap-2">
                            {item.highlights.map(h => (
                              <span key={h} className="px-4 py-2 rounded-full border border-white/10 bg-white/5 backdrop-blur-md text-[10px] font-black uppercase tracking-widest text-cyan-400">
                                {h}
                              </span>
                            ))}
                          </div>
                        </motion.div>
                      ) : (
                        <motion.div 
                          key="inactive"
                          className="flex h-full items-end lg:mb-12"
                        >
                          <h3 className="text-2xl font-black uppercase tracking-tighter text-white/20 lg:-rotate-90 lg:origin-left whitespace-nowrap">
                            {item.title}
                          </h3>
                        </motion.div>
                      )}
                    </AnimatePresence>
                  </div>
                </div>

                {/* Active Border Beam Effect */}
                {isActive && (
                  <motion.div layoutId="borderBeam" className="absolute inset-0 border-2 border-cyan-400/30 rounded-[2rem] pointer-events-none z-30" />
                )}
              </motion.div>
            );
          })}
        </div>
      </section>
    </main>
  );
}
