"use client";

import React, { useRef } from "react";
import { motion, useScroll, useTransform, useSpring } from "framer-motion";
import {
  Plane, Ship, Truck, Warehouse,
  Globe, Users, Shield, MapPin,
  ChevronRight, Activity, Zap
} from "lucide-react";

const OVERVIEW_BLOCKS = [
  { title: "Air Freight", description: "Strategic airline partnerships for time-critical cargo.", icon: <Plane />, color: "from-sky-400 to-blue-600" },
  { title: "Ocean Freight", description: "Global FCL/LCL movement through major seaports.", icon: <Ship />, color: "from-blue-500 to-cyan-400" },
  { title: "Inland Tech", description: "Domestic cross-border uninterrupted cargo movement.", icon: <Truck />, color: "from-indigo-500 to-purple-500" },
  { title: "Smart Warehousing", description: "Scalable inventory systems for supply continuity.", icon: <Warehouse />, color: "from-violet-500 to-fuchsia-500" },
];

const METRICS = [
  { label: "Destinations", value: "80+", icon: <Globe /> },
  { label: "Members", value: "58+", icon: <MapPin /> },
  { label: "Strength", value: "270+", icon: <Users /> },
];

export function NetworkContent() {
  const containerRef = useRef(null);
  const { scrollYProgress } = useScroll({
    target: containerRef,
    offset: ["start start", "end end"]
  });

  // Smooth spring physics for parallax
  const smoothY = useSpring(useTransform(scrollYProgress, [0, 1], [0, -100]), { stiffness: 100, damping: 30 });
  const bgScale = useTransform(scrollYProgress, [0, 1], [1.1, 1]);

  return (
    <div ref={containerRef} className="relative w-full lg:w-[55%] min-h-screen text-white">

      {/* --- CINEMATIC FIXED BACKGROUND --- */}
      <div className="fixed inset-0 z-0 pointer-events-none">
        <motion.div
          style={{ scale: bgScale }}
          className="absolute inset-0 bg-cover bg-center bg-no-scroll"
          // Replace URL with your actual asset path
          className="w-full h-full bg-[url('/watermarked_img_2473144145540261641.png')] opacity-40 grayscale-[20%]"
        />
        <div className="absolute inset-0 bg-gradient-to-r from-black via-black/60 to-transparent" />
        <div className="absolute inset-0 bg-[url('https://grainy-gradients.vercel.app/noise.svg')] opacity-20 mix-blend-overlay" />
      </div>

      {/* --- CONTENT LAYER --- */}
      <motion.div style={{ y: smoothY }} className="relative z-10 px-6 md:px-12 lg:pl-20 lg:pr-10 pt-24 pb-40">

        {/* 1. FLOATING HUD METRICS */}
        <section className="mb-24 flex flex-wrap gap-4">
          {METRICS.map((metric, i) => (
            <motion.div
              key={metric.label}
              initial={{ opacity: 0, scale: 0.8 }}
              animate={{ opacity: 1, scale: 1 }}
              transition={{ delay: i * 0.1, type: "spring" }}
              whileHover={{ y: -5, backgroundColor: "rgba(59, 130, 246, 0.1)" }}
              className="flex items-center gap-4 bg-white/5 border border-white/10 backdrop-blur-xl px-6 py-3 rounded-2xl"
            >
              <div className="text-blue-400 p-2 bg-blue-500/10 rounded-lg">{metric.icon}</div>
              <div>
                <div className="text-2xl font-black tracking-tighter leading-none">{metric.value}</div>
                <div className="text-[10px] uppercase tracking-widest text-blue-500/80 font-bold">{metric.label}</div>
              </div>
            </motion.div>
          ))}
        </section>

        {/* 2. GLITCH HERO HEADER */}
        <header className="mb-40">
          <motion.div
            initial={{ opacity: 0, x: -50 }}
            whileInView={{ opacity: 1, x: 0 }}
            transition={{ duration: 1, ease: [0.16, 1, 0.3, 1] }}
          >
            <div className="flex items-center gap-3 mb-6">
              <span className="h-[2px] w-8 bg-blue-500 animate-pulse" />
              <p className="text-[10px] font-black tracking-[0.6em] text-blue-400 uppercase italic">
                Vector: Orbital // Node: Active
              </p>
            </div>

            <h2 className="text-7xl md:text-[9rem] font-black leading-[0.8] tracking-tighter mb-8">
              CORE <br />
              <span className="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-white to-white/10 animate-gradient-x">
                ENGINE.
              </span>
            </h2>

            <p className="text-zinc-400 text-xl max-w-md font-light leading-relaxed border-l-2 border-blue-500/20 pl-6 hover:border-blue-500 transition-colors duration-500">
              Transforming standard freight into a high-velocity digital ecosystem.
            </p>
          </motion.div>
        </header>

        {/* 3. 3D HOVER CARD GRID */}
        <section className="grid grid-cols-1 md:grid-cols-2 gap-8 mb-32">
          {OVERVIEW_BLOCKS.map((block, i) => (
            <motion.div
              key={block.title}
              initial={{ opacity: 0, y: 100 }}
              whileInView={{ opacity: 1, y: 0 }}
              viewport={{ once: true }}
              transition={{ delay: i * 0.1, duration: 0.8 }}
              whileHover={{
                rotateX: 5,
                rotateY: -5,
                z: 50,
                transition: { duration: 0.2 }
              }}
              className="perspective-1000 group relative p-10 rounded-[2.5rem] bg-white/[0.03] border border-white/5 overflow-hidden hover:bg-white/[0.07] transition-all duration-700"
            >
              <div className={`absolute top-0 right-0 w-32 h-32 bg-gradient-to-br ${block.color} opacity-0 group-hover:opacity-20 blur-3xl transition-opacity`} />

              <div className="mb-8 w-16 h-16 rounded-2xl bg-white/5 flex items-center justify-center group-hover:scale-110 group-hover:rotate-12 transition-transform duration-500">
                {React.cloneElement(block.icon as React.ReactElement, { className: "w-8 h-8 text-blue-400" })}
              </div>

              <h3 className="text-3xl font-bold mb-4 tracking-tight group-hover:translate-x-2 transition-transform">
                {block.title}
              </h3>
              <p className="text-zinc-500 group-hover:text-zinc-300 transition-colors leading-relaxed">
                {block.description}
              </p>

              <div className="mt-10 h-[1px] w-full bg-gradient-to-r from-blue-500 to-transparent scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-700" />
            </motion.div>
          ))}
        </section>

        {/* 4. SCANLINE CONNECTIVITY SECTION */}
        <section className="relative overflow-hidden p-12 rounded-[3rem] border border-blue-500/20 bg-black/40 backdrop-blur-3xl">
          <motion.div
            animate={{ y: ["0%", "100%"] }}
            transition={{ repeat: Infinity, duration: 4, ease: "linear" }}
            className="absolute top-0 left-0 w-full h-1/2 bg-gradient-to-b from-transparent via-blue-500/10 to-transparent pointer-events-none"
          />

          <h2 className="text-4xl font-black mb-12 flex items-center gap-4">
            <Zap className="text-blue-500 animate-bounce" />
            Global Uplink
          </h2>

          <div className="space-y-10">
            {["Asia-Pacific Hubs", "Trans-Atlantic Corridors", "Middle-East Gateways"].map((region, i) => (
              <motion.div
                key={region}
                initial={{ opacity: 0, x: -30 }}
                whileInView={{ opacity: 1, x: 0 }}
                transition={{ delay: i * 0.2 }}
                className="flex items-center gap-6 group/line"
              >
                <div className="w-4 h-4 rounded-full border border-blue-500 group-hover/line:bg-blue-500 shadow-[0_0_15px_rgba(59,130,246,0.5)] transition-all" />
                <span className="text-xl font-medium text-zinc-400 group-hover/line:text-white transition-colors">{region}</span>
                <div className="flex-grow h-[1px] bg-zinc-800 group-hover/line:bg-blue-900 transition-colors" />
                <Activity className="w-4 h-4 text-blue-500/40 group-hover/line:text-blue-400" />
              </motion.div>
            ))}
          </div>
        </section>

      </motion.div>
    </div>
  );
}
