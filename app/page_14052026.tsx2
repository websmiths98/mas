"use client";
import Image from "next/image";
import Link from "next/link";
import HeroSection from "./components/HeroSection";
import { AppleGlassNav } from "./components/AppleGlassNav";

const NAV_LINKS = [
    { name: "Home", href: "/" },
    { name: "Services", href: "/services" },
    { name: "Solutions", href: "/solutions" },
    { name: "Network", href: "/network" },
    { name: "Industries", href: "/industry" },
    { name: "About us", href: "/about" },
];

export default function Home() {
  return (
    <main className="min-h-screen bg-[#E5E4E2] relative overflow-x-hidden text-gray-900">

      {/* ── Fixed Header Container ── */}
      <div className="fixed top-8 left-1/2 -translate-x-1/2 z-[100] w-auto">
        <AppleGlassNav 
          items={NAV_LINKS} 
          logo={
            <Link href="/" className="flex items-center">
              <Image
                src="/mas_logo.webp"
                alt="Logo"
                width={200}
                height={50}
                /* 
                   h-8 ensures the logo is exactly 32px tall, 
                   fitting inside the bar without increasing its layout size.
                   w-32 makes it double-width (128px).
                */
                className="h-9 w-15 object-contain" 
                priority
              />
            </Link>
          }
        />
      </div>

      <HeroSection />

      {/* New Responsive Image Marquee Slider Section */}

    </main>
  );
}
